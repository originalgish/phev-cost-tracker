{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "phev-cost-tracker",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/setup/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "phev-cost-tracker",
      "database_id": "29fd241a-0450-4c23-9bd1-acfad9781b1d",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://white-morning-ac7b.cloudflareaccess.com",
    "ACCESS_AUD": "fae5d85de660945cac9a6990ba973fc458562821502fa3b4ea8d22a836c18ead",
    "TIMEZONE": "Europe/Helsinki"
  }
}
